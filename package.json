{
  "name": "tuberift",
  "version": "1.0.0",
  "description": "YouTube video downloader powered by yt-dlp",
  "main": "dist-electron/electron/main/main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "concurrently \"vite\" \"DEV_MODE=1 electron .\"",
    "dev:win": "concurrently \"vite\" \"set DEV_MODE=1 && electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.noidar.tuberift",
    "productName": "Tuberift",
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/",
        "to": "bin/",
        "filter": ["yt-dlp", "yt-dlp.exe"]
      },
      {
        "from": "node_modules/ffmpeg-static/",
        "to": "ffmpeg-static/",
        "filter": ["ffmpeg", "ffmpeg.exe"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "pkg"]
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "asar": true,
    "asarUnpack": ["node_modules/ffmpeg-static/**"]
  },
  "dependencies": {
    "electron-store": "^6.0.1",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^6.1.6",
    "@mui/material": "^6.1.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.1",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
